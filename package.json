{
  "name": "runar-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:test": "cd contract && vitest run",
    "contract:test:integration": "cd contract/integration && vitest run",
    "contract:test:watch": "cd contract && vitest",
    "contract:typecheck": "cd contract && tsc --noEmit",
    "contract:compile": "cd contract && runar compile TicTacToe.runar.ts -o artifacts",
    "contract:debug": "cd contract && runar debug artifacts/TicTacToe.runar.json",
    "contract:debug:move": "cd contract && runar debug artifacts/TicTacToe.runar.json --method move --args '{\"position\": 4, \"player\": \"03a34b99f22c790c4e36b2b3c2c35a36db06226e41c692fc82b8b56ac1c540c5bd\", \"sig\": \"\"}'",
    "contract:debug:join": "cd contract && runar debug artifacts/TicTacToe.runar.json --method join --args '{\"opponentPK\": \"03d6bfe100d1600c0d8f769501676fc74c3809500bd131c8a549f88cf616c21f35\", \"sig\": \"\"}'",
    "frontend:dev": "cd frontend && vite",
    "frontend:build": "cd frontend && tsc && vite build",
    "frontend:preview": "cd frontend && vite preview",
    "frontend:typecheck": "cd frontend && tsc --noEmit",
    "codegen": "npx runar compile contract/TicTacToe.runar.ts -o contract/artifacts/ && npx runar codegen contract/artifacts/TicTacToe.runar.json -o frontend/src/generated/",
    "overlay:dev": "cd overlay && tsx watch src/index.ts",
    "overlay:dev:regtest": "cd overlay && REGTEST=true tsx watch src/index.ts",
    "overlay:start": "cd overlay && tsx src/index.ts",
    "overlay:typecheck": "cd overlay && tsc --noEmit",
    "overlay:test:regtest": "cd overlay && vitest run --config vitest.regtest.config.ts",
    "typecheck": "npm run contract:typecheck && npm run frontend:typecheck && npm run overlay:typecheck",
    "test": "npm run contract:test"
  },
  "dependencies": {
    "@bsv/message-box-client": "^2.0.4",
    "@bsv/overlay": "^2.0.2",
    "@bsv/sdk": "^2.0.7",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "knex": "^3.1.0",
    "mongodb": "^6.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "runar-lang": "file:../runar/packages/runar-lang",
    "runar-overlay-express": "file:../runar-overlay-express",
    "runar-react": "file:../runar-react",
    "runar-sdk": "file:../runar/packages/runar-sdk"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "runar-cli": "file:../runar/packages/runar-cli",
    "runar-compiler": "file:../runar/packages/runar-compiler",
    "runar-ir-schema": "file:../runar/packages/runar-ir-schema",
    "runar-testing": "file:../runar/packages/runar-testing",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
